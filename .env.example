# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://skilciti.com

# Contact form delivery via Resend (https://resend.com).
# Without RESEND_API_KEY the form logs messages to the server console in development
# and returns a friendly "email us directly" error in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@skilciti.com
# Must be a sender on a domain you've verified in Resend (the default only works for testing).
CONTACT_FROM_EMAIL="Skilciti Website <onboarding@resend.dev>"
